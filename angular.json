					}
				}
			}
		},
		"shared-cart": {
			"projectType": "library",
			"root": "projects/shared-cart",
			"sourceRoot": "projects/shared-cart",
			"prefix": "lib",
			"architect": {
				"build": {
					"builder": "@angular/build:library",
					"options": {
						"tsConfig": "projects/shared-cart/tsconfig.lib.json"
					},
					"configurations": {
						"production": {},
						"development": {
							"compilationMode": "full",
							"declarationMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"test": {
					"builder": "@angular/build:unit-test",
					"options": {
						"tsConfig": "projects/shared-cart/tsconfig.spec.json"
					}
				}
			}
		}
	}
}